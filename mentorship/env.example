# =============================================================================
# MENTORS FEEDBACK CHANNEL — ENVIRONMENT
# =============================================================================
# Data Analysis Bootcamp · ITF-NECA × Shamzbridge Consult
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp mentorship/env.example .env.local
#   2. Fill in the values marked  ← REQUIRED  and  ← PROVIDE THIS
#   3. Restart the dev server (env vars are only read at boot)
#
# Never commit .env.local — it is gitignored. This file is the template, and
# is safe to commit because it contains no real secrets.
#
# WHAT HAPPENS IF A SECTION IS MISSING
#   Section 1 (SMTP)        nothing sends — every form returns a clear 503
#   Section 2 (Neon)        emails still go out, nothing is recorded, the
#                           dashboard says so plainly
#   Section 3 (Cloudinary)  uploads fall back to email attachments (Gmail
#                           caps a message at roughly 25 MB)
#   Section 4 (Admin)       falls back to the defaults in
#                           mentorship/lib/admin-auth.ts — guessable, so set these
#
# The /admin dashboard shows a live health strip for sections 1–3, so you can
# see at a glance which of these have actually connected.
# =============================================================================


# =============================================================================
# 1. EMAIL DELIVERY — Gmail SMTP                                   ← REQUIRED
# =============================================================================
# This is the only section the app cannot run without.
#
# SMTP_PASS is NOT the normal Gmail password. It is a 16-character Google
# "App Password". To generate one:
#   1. Sign in to the Google account below at https://myaccount.google.com
#   2. Turn on 2-Step Verification (app passwords do not appear without it)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create one named e.g. "Mentors Feedback Channel"
#   5. Paste the 16 characters below — spaces can be removed
# -----------------------------------------------------------------------------

# The Gmail account that sends every email.                    ← PROVIDE THIS
SMTP_USER=shamzbridgeconsult@gmail.com

# The 16-character Google App Password.                        ← PROVIDE THIS
# Spaces are stripped for you, so pasting "abcd efgh ijkl mnop" is fine.
SMTP_PASS=abcdefghijklmnop

# Check it without filling in a form:  npm run check-mail
# Add an address to also send a test:  npm run check-mail -- you@example.com
# A "535 BadCredentials" reply means the password is wrong, expired, or was
# issued for a different Google account. The /admin health strip says the same.


# ---- Optional overrides for section 1 ----------------------------------------

# Where every submission is delivered. Defaults to hostCompany.email in
# mentorship/data/roster.json, which is currently shamzbridgeconsult@gmail.com.
# Useful for pointing submissions at a test inbox before launch.
# FEEDBACK_INBOX=shamzbridgeconsult@gmail.com

# The display name recipients see in the "From" field.
# Defaults to the programme name from roster.json.
# MAIL_FROM_NAME=Data Analysis Bootcamp

# Only change these two if you move off Gmail (e.g. to SendGrid or Zoho).
# Port 465 is treated as TLS; anything else is sent as STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465


# =============================================================================
# 2. NEON POSTGRES — the record of every submission
# =============================================================================
# Where to find it:
#   Neon console → your project → Connection Details → copy the
#   "Pooled connection" string (the host contains "-pooler").
#
# Use the POOLED string, not the direct one — this app connects over HTTP from
# serverless functions, which is what the pooler is for.
#
# Keep ?sslmode=require on the end; Neon rejects unencrypted connections.
#
# You do NOT need to create any tables. The seven tables in mentorship/lib/db.ts are
# created automatically the first time the app talks to the database, and
# every statement is idempotent, so there is no migration step to run.
# -----------------------------------------------------------------------------

#                                                              ← PROVIDE THIS
DATABASE_URL=postgresql://neondb_owner:npg_XXXXXXXXXXXX@ep-cool-name-a1b2c3d4-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Accepted as an alias if your host injects that name instead (Vercel's Neon
# integration sometimes does). DATABASE_URL wins if both are set.
# NEON_DATABASE_URL=


# =============================================================================
# 3. CLOUDINARY — resource uploads and sharing
# =============================================================================
# Where to find them:
#   Cloudinary console → Dashboard → "Product Environment Credentials".
#   All three values are on that one screen.
#
# Slides, PDFs and documents are uploaded here and shared as links, which
# sidesteps Gmail's attachment ceiling and gives you one durable place to find
# every resource anyone has shared.
#
# The API secret is a real secret — it can delete your media. Never expose it
# to the browser (no NEXT_PUBLIC_ prefix on any of these).
# -----------------------------------------------------------------------------

#                                                              ← PROVIDE THIS
CLOUDINARY_CLOUD_NAME=dxxxxxxxx
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=aBcDeFgHiJkLmNoPqRsTuVwXyZ12

# Optional — the top-level folder everything is filed under in your media
# library. Files land in <folder>/<form-name>/, e.g. mentors-feedback-channel/
# mentor-reports/. Defaults to "mentors-feedback-channel".
# CLOUDINARY_FOLDER=mentors-feedback-channel


# =============================================================================
# 4. ORGANISER LOGIN — the only account in the app         ← CHANGE BEFORE LIVE
# =============================================================================
# Mentors and mentees never sign in; they are recognised by picking their name
# from the roster. These three values guard /admin and nothing else.
#
# If you leave these unset the app falls back to the defaults hardcoded in
# mentorship/lib/admin-auth.ts, which are in the source and therefore public. Set
# them before the site is reachable by anyone else.
# -----------------------------------------------------------------------------

ADMIN_USERNAME=shamzbridge

# Pick something long. This is the only thing between the public internet and
# every mentee's written feedback.
ADMIN_PASSWORD=change-this-before-launch

# Signs the admin session cookie, so a session cannot be forged or extended.
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value signs everyone out immediately, which is the fastest way
# to revoke access if a password leaks.
ADMIN_SECRET=replace-with-a-long-random-string
